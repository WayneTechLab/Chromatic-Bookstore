VITE_FIREBASE_AUTH_DOMAIN=chromatic-bookstore.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=chromatic-bookstore
VITE_FIREBASE_STORAGE_BUCKET=chromatic-bookstore.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=444767911955
VITE_FIREBASE_APP_ID=1:444767911955:web:c69f18c8e610cebc10ffe6
VITE_FIREBASE_MEASUREMENT_ID=G-YK5N9P1ZP6

# Non-secret WSG setup metadata.
VITE_WSG_ACCOUNT_LEVELS=0,1,2,3,4,5
VITE_WSG_SENDER_PROVIDER=google
VITE_WSG_SENDER_EMAIL=sender@example.com
VITE_WSG_DNS_PROVIDER=godaddy

# Optional
VITE_FUNCTIONS_BASE_URL=
